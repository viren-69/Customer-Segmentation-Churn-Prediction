{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Re-run all notebooks",
      "type": "debugpy",
      "request": "launch",
      "module": "jupyter",
      "args": ["nbconvert", "--to", "notebook", "--execute", "--inplace",
               "--ExecutePreprocessor.timeout=900",
               "01_rfm_segmentation.ipynb", "02_churn_eda.ipynb", "03_churn_model.ipynb"],
      "cwd": "${workspaceFolder}/notebooks",
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
